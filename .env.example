# Where the console is deployed (the "Sign in" links point here)
NEXT_PUBLIC_CONSOLE_URL=http://localhost:3001
# The documentation site
NEXT_PUBLIC_DOCS_URL=https://abeyance-docs.vercel.app

# Partner form email, sent through Resend (server only, never NEXT_PUBLIC_).
# API key from https://resend.com/api-keys
RESEND_API_KEY=
# Team addresses that receive design partner requests, comma-separated.
# Until a domain is verified in Resend, mail can only be sent from
# onboarding@resend.dev, and only to the Resend account owner's own address.
# So this must be that address until a domain is verified.
ABEYANCE_LEADS_TO=
# Sender. Defaults to the sandbox sender below. Confirmation emails to the
# person who filled in the form are only sent once this is on a verified domain.
EMAIL_FROM="Abeyance <onboarding@resend.dev>"
